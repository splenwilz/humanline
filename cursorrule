curl -i "http://localhost:8000/health"            # quick health check to verify server is up

# POST JSON example (create resource)
curl -i -X POST "http://localhost:8000/users" \
  -H "Content-Type: application/json" \
  -d '{"name":"alice"}'

# Expectation: check HTTP status, response shape, and headers before writing tests
