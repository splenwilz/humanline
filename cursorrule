## Example: small FastAPI route with per-line comments

```py
from fastapi import APIRouter, Depends, HTTPException  # imports required for routing and errors
from pydantic import BaseModel                            # schema validation type

router = APIRouter()                                      # router to group related endpoints

class Ping(BaseModel):                                     # request schema for ping endpoint
    msg: str                                              # message payload

class Pong(BaseModel):                                     # response schema for ping
    echo: str                                             # echoed message

@router.post("/ping", response_model=Pong)               # expose POST /ping returning Pong
async def ping(payload: Ping):                             # handler receives typed payload
    # guard: require a message; provide clear client error
    if not payload.msg:                                   # precondition check avoids nulls
        raise HTTPException(status_code=400, detail="msg required")  # explicit error for client
    # happy path: echo the message back
    return Pong(echo=payload.msg)                         # return typed response to consumers
```

